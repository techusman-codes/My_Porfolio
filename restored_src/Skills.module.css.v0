.skills {
  background: var(--bg-color);
}

.sectionHeader {
  text-align: center;
  margin-bottom: 4rem;
}

.skillsGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 1.5rem;
}

.skillCard {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  border-radius: 1rem;
  transition: all 0.3s ease;
  cursor: pointer;
}

.iconWrapper {
  font-size: 2.5rem;
  color: var(--text-primary);
  margin-bottom: 1rem;
  transition: all 0.3s ease;
}

.skillCard:hover .iconWrapper {
  color: var(--accent-color);
}

.skillCard p {
  color: var(--text-secondary);
  font-weight: 500;
  font-size: 0.9rem;
}

.skillCard:hover p {
  color: var(--text-primary);
}